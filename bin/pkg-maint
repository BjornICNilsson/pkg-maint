#!/usr/bin/env sh

set -u

PROGRAM=${0##*/}
TAB=$(printf '\t')

CHECK_ONLY=0
ASSUME_YES=0
MANAGER="all"
VERBOSE=0
MIGRATE_NVM=0
MIGRATE_NVM_FROM=""

RUN_ID="$(date '+%Y%m%dT%H%M%S%z')-$$"
RUN_STARTED=0
LOG_WARNING_EMITTED=0

PIP_OUTDATED_COUNT=0
UV_TOOL_COUNT=0
UV_OUTDATED_COUNT=0
NPM_PACKAGE_COUNT="unknown"
NPM_OUTDATED_COUNT=0
NPM_ACTIVE_PREFIX="unknown"
NVM_INACTIVE_PREFIX_COUNT=0
NPM_ENV_INSPECTED=0

MIGRATION_SOURCE=""
MIGRATION_PACKAGE_COUNT=0
MIGRATION_MIGRATED_COUNT=0
MIGRATION_FAILED_COUNT=0

total_count=0
hold_count=0
install_count=0
runtime_error=0
updated_count=0
failed_count=0
RUN_OUTCOME="started"

DEFAULT_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/pkg-maint/config.env"
CONFIG_FILE="$DEFAULT_CONFIG"

PIP_EXCLUDE=""
UV_EXCLUDE=""
NPM_EXCLUDE=""
PIP_CMD="python3 -m pip"
UV_CMD="uv"
NPM_CMD="npm"
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/pkg-maint/history.log"

usage() {
  cat <<USAGE
Usage: $PROGRAM [options]

Options:
  --check                 List updates only; do not install
  --yes                   Install without confirmation prompt
  --manager <pip|uv|npm|all>  Limit scope to one manager (default: all)
  --migrate-nvm           Migrate missing packages from an inactive NVM version
  --migrate-nvm-from <version>  Select a specific inactive NVM source version
  --config <path>         Use a custom config file
  --verbose               Print scan details and install command output
  -h, --help              Show this help
USAGE
}

warn() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
}

verbose() {
  if [ "$VERBOSE" -eq 1 ]; then
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
  fi
}

verbose_file() {
  file=$1
  if [ "$VERBOSE" -eq 1 ] && [ -s "$file" ]; then
    sed 's/^/  /' "$file" >&2
  fi
}

die() {
  warn "$*"
  exit 1
}

first_word() {
  set -- $1
  if [ "$#" -eq 0 ]; then
    return 1
  fi
  printf '%s\n' "$1"
}

is_excluded() {
  list=$1
  item=$2
  case " $list " in
    *" $item "*) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_log_dir() {
  log_dir=$(dirname "$LOG_FILE")
  mkdir -p "$log_dir" 2>/dev/null
}

log_warning() {
  if [ "$LOG_WARNING_EMITTED" -eq 0 ]; then
    warn "unable to write history log: $LOG_FILE"
    LOG_WARNING_EMITTED=1
  fi
}

log_result() {
  manager_name=$1
  package_name=$2
  old_version=$3
  new_version=$4
  result=$5

  if ! ensure_log_dir; then
    log_warning
    return 1
  fi

  if ! printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "$manager_name" \
    "$package_name" \
    "$old_version" \
    "$new_version" \
    "$result" >>"$LOG_FILE" 2>/dev/null
  then
    log_warning
    return 1
  fi

  return 0
}

log_event() {
  event_type=$1
  event_subject=$2
  event_result=$3
  log_result "$event_type" "$event_subject" "-" "-" "$event_result" || true
}

pip_list_outdated() {
  # shellcheck disable=SC2086
  set -- $PIP_CMD
  "$@" list --outdated --format=json
}

pip_install_pkg() {
  package_name=$1
  # shellcheck disable=SC2086
  set -- $PIP_CMD
  "$@" install --upgrade "$package_name"
}

npm_list_outdated() {
  # shellcheck disable=SC2086
  set -- $NPM_CMD
  "$@" outdated -g --json
}

npm_install_pkg() {
  package_name=$1
  # shellcheck disable=SC2086
  set -- $NPM_CMD
  "$@" install -g "${package_name}@latest"
}

npm_install_spec() {
  package_spec=$1
  # shellcheck disable=SC2086
  set -- $NPM_CMD
  "$@" install -g "$package_spec"
}

npm_active_prefix() {
  # shellcheck disable=SC2086
  set -- $NPM_CMD
  "$@" config get prefix
}

inspect_npm_environment() {
  if [ "$NPM_ENV_INSPECTED" -eq 1 ]; then
    return 0
  fi
  NPM_ENV_INSPECTED=1
  NVM_INACTIVE_PREFIX_COUNT=0
  if [ -n "${NVM_MIGRATION_FILE:-}" ]; then
    : >"$NVM_MIGRATION_FILE"
  fi

  npm_prefix_err=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-npm-prefix-err.XXXXXX") || return 0
  npm_environment=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-npm-environment.XXXXXX") || {
    rm -f "$npm_prefix_err"
    return 0
  }

  if NPM_ACTIVE_PREFIX=$(npm_active_prefix 2>"$npm_prefix_err"); then
    NPM_ACTIVE_PREFIX=$(printf '%s\n' "$NPM_ACTIVE_PREFIX" | tail -n 1)
  else
    NPM_ACTIVE_PREFIX="unknown"
    verbose "unable to determine active npm prefix"
    verbose_file "$npm_prefix_err"
    rm -f "$npm_prefix_err" "$npm_environment"
    return 0
  fi

  nvm_root=${NVM_DIR:-$HOME/.nvm}
  if ! python3 - "$NPM_ACTIVE_PREFIX" "$nvm_root" >"$npm_environment" <<'PY'
import json
import pathlib
import sys

active_prefix = pathlib.Path(sys.argv[1]).expanduser()
nvm_root = pathlib.Path(sys.argv[2]).expanduser()


def packages(prefix):
    root = prefix / "lib" / "node_modules"
    found = {}
    if not root.is_dir():
        return found
    for entry in root.iterdir():
        if entry.name.startswith("@") and entry.is_dir():
            candidates = entry.iterdir()
        else:
            candidates = (entry,)
        for candidate in candidates:
            package_json = candidate / "package.json"
            if not package_json.is_file():
                continue
            try:
                data = json.loads(package_json.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            name = data.get("name")
            version = data.get("version")
            if isinstance(name, str) and name and isinstance(version, str) and version:
                kind = "linked" if candidate.is_symlink() else "registry"
                found[name] = (version, kind)
    return found


active_packages = packages(active_prefix)
active_names = set(active_packages)
print(f"ACTIVE\t{len(active_names)}")

versions_dir = nvm_root / "versions" / "node"
try:
    active_resolved = active_prefix.resolve()
except OSError:
    active_resolved = active_prefix

if versions_dir.is_dir():
    for prefix in sorted(versions_dir.iterdir()):
        if not prefix.is_dir():
            continue
        try:
            if prefix.resolve() == active_resolved:
                continue
        except OSError:
            if prefix == active_prefix:
                continue
        source_packages = packages(prefix)
        extra_names = sorted(set(source_packages) - active_names)
        if extra_names:
            print(f"INACTIVE\t{prefix.name}\t{','.join(extra_names)}")
            for name in extra_names:
                version, kind = source_packages[name]
                print(f"PACKAGE\t{prefix.name}\t{prefix}\t{name}\t{version}\t{kind}")
PY
  then
    verbose "unable to inspect npm/NVM package directories"
    rm -f "$npm_prefix_err" "$npm_environment"
    return 0
  fi

  while IFS="$TAB" read -r record_type field1 field2 field3 field4 field5; do
    case "$record_type" in
      ACTIVE)
        NPM_PACKAGE_COUNT=${field1:-unknown}
        ;;
      INACTIVE)
        NVM_INACTIVE_PREFIX_COUNT=$((NVM_INACTIVE_PREFIX_COUNT + 1))
        warn "inactive NVM prefix $field1 contains packages absent from active prefix: $field2"
        log_event "scan" "npm" "run=$RUN_ID inactive_nvm_prefix=$field1 packages=$field2"
        ;;
      PACKAGE)
        if [ -n "${NVM_MIGRATION_FILE:-}" ]; then
          printf '%s\t%s\t%s\t%s\t%s\n' "$field1" "$field2" "$field3" "$field4" "$field5" >>"$NVM_MIGRATION_FILE"
        fi
        ;;
    esac
  done <"$npm_environment"

  verbose "npm active prefix: $NPM_ACTIVE_PREFIX (global packages=$NPM_PACKAGE_COUNT)"
  verbose_file "$npm_prefix_err"
  rm -f "$npm_prefix_err" "$npm_environment"
}

print_migration_sources() {
  source_number=0
  while IFS="$TAB" read -r source_version source_prefix; do
    source_number=$((source_number + 1))
    source_count=$(awk -F '\t' -v source="$source_version" '$1 == source { count += 1 } END { print count + 0 }' "$NVM_MIGRATION_FILE")
    printf '  %s) %s (%s packages)\n' "$source_number" "$source_version" "$source_count"
  done <"$NVM_SOURCES_FILE"
}

select_migration_source() {
  awk -F '\t' '!seen[$1]++ { print $1 "\t" $2 }' "$NVM_MIGRATION_FILE" | sort >"$NVM_SOURCES_FILE"
  source_count=$(wc -l <"$NVM_SOURCES_FILE" | tr -d ' ')

  if [ "$source_count" -eq 0 ]; then
    return 0
  fi

  if [ -n "$MIGRATE_NVM_FROM" ]; then
    requested_source=$MIGRATE_NVM_FROM
    case "$requested_source" in
      v*) alternate_source=${requested_source#v} ;;
      *) alternate_source="v$requested_source" ;;
    esac
    MIGRATION_SOURCE=$(awk -F '\t' -v first="$requested_source" -v second="$alternate_source" '$1 == first || $1 == second { print $1; exit }' "$NVM_SOURCES_FILE")
    if [ -z "$MIGRATION_SOURCE" ]; then
      warn "requested NVM source not found or has no packages to migrate: $MIGRATE_NVM_FROM"
      return 1
    fi
    return 0
  fi

  if [ "$source_count" -eq 1 ]; then
    IFS="$TAB" read -r MIGRATION_SOURCE ignored_prefix <"$NVM_SOURCES_FILE"
    return 0
  fi

  printf 'Multiple inactive NVM environments contain migratable packages:\n'
  print_migration_sources

  if [ "$CHECK_ONLY" -eq 1 ]; then
    MIGRATION_PACKAGE_COUNT=$(wc -l <"$NVM_MIGRATION_FILE" | tr -d ' ')
    printf 'Use --migrate-nvm-from <version> to preview one source.\n'
    return 2
  fi

  if [ "$ASSUME_YES" -eq 1 ]; then
    warn "multiple NVM sources require --migrate-nvm-from when using --yes"
    return 1
  fi

  printf 'Select source [1-%s, q to cancel]: ' "$source_count"
  read -r source_answer || source_answer="q"
  case "$source_answer" in
    q|Q|"")
      return 3
      ;;
    *[!0-9]*)
      warn "invalid migration source selection: $source_answer"
      return 1
      ;;
  esac
  if [ "$source_answer" -lt 1 ] || [ "$source_answer" -gt "$source_count" ]; then
    warn "migration source selection out of range: $source_answer"
    return 1
  fi

  selected_source_line=$(sed -n "${source_answer}p" "$NVM_SOURCES_FILE")
  MIGRATION_SOURCE=${selected_source_line%%"$TAB"*}
  return 0
}

print_migration_preview() {
  MIGRATION_PACKAGE_COUNT=$(awk -F '\t' -v source="$MIGRATION_SOURCE" '$1 == source { count += 1 } END { print count + 0 }' "$NVM_MIGRATION_FILE")
  printf 'NVM package migration preview\n'
  printf '  Source: %s\n' "$MIGRATION_SOURCE"
  printf '  Active target: %s\n' "$NPM_ACTIVE_PREFIX"
  printf '  Packages:\n'
  while IFS="$TAB" read -r source_version source_prefix package_name package_version package_kind; do
    [ "$source_version" = "$MIGRATION_SOURCE" ] || continue
    if [ "$package_kind" = "linked" ]; then
      printf '    %-36s %-16s %s\n' "$package_name" "$package_version" "linked (unsupported)"
    else
      printf '    %-36s %s\n' "$package_name" "$package_version"
    fi
  done <"$NVM_MIGRATION_FILE"
}

verify_migrated_package() {
  verify_name=$1
  verify_version=$2
  python3 - "$NPM_ACTIVE_PREFIX" "$verify_name" "$verify_version" <<'PY'
import json
import pathlib
import sys

prefix = pathlib.Path(sys.argv[1])
name = sys.argv[2]
expected = sys.argv[3]
package_json = prefix / "lib" / "node_modules" / name / "package.json"
try:
    actual = json.loads(package_json.read_text(encoding="utf-8")).get("version")
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)
raise SystemExit(0 if actual == expected else 1)
PY
}

perform_nvm_migration() {
  if awk -F '\t' -v source="$MIGRATION_SOURCE" '$1 == source && $5 == "linked" { found = 1 } END { exit found ? 0 : 1 }' "$NVM_MIGRATION_FILE"; then
    warn "source $MIGRATION_SOURCE contains linked global packages; automatic migration is not supported"
    return 1
  fi

  while IFS="$TAB" read -r source_version source_prefix package_name package_version package_kind; do
    [ "$source_version" = "$MIGRATION_SOURCE" ] || continue
    migration_log=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-migration-log.XXXXXX") || {
      warn "unable to create migration log for $package_name"
      MIGRATION_FAILED_COUNT=$((MIGRATION_FAILED_COUNT + 1))
      continue
    }
    package_spec="$package_name@$package_version"
    printf 'Migrating %s (%s) to active npm prefix...\n' "$package_name" "$package_version"
    if npm_install_spec "$package_spec" >"$migration_log" 2>&1 && verify_migrated_package "$package_name" "$package_version"; then
      MIGRATION_MIGRATED_COUNT=$((MIGRATION_MIGRATED_COUNT + 1))
      log_result "migration" "$package_name" "$source_version" "$package_version" "ok run=$RUN_ID target=$NPM_ACTIVE_PREFIX"
      verbose_file "$migration_log"
    else
      MIGRATION_FAILED_COUNT=$((MIGRATION_FAILED_COUNT + 1))
      warn "failed to migrate $package_name from $source_version"
      verbose_file "$migration_log"
      log_result "migration" "$package_name" "$source_version" "$package_version" "failed run=$RUN_ID target=$NPM_ACTIVE_PREFIX"
    fi
    rm -f "$migration_log"
  done <"$NVM_MIGRATION_FILE"

  printf 'Migration summary: requested=%s migrated=%s failed=%s\n' \
    "$MIGRATION_PACKAGE_COUNT" "$MIGRATION_MIGRATED_COUNT" "$MIGRATION_FAILED_COUNT"

  if [ "$MIGRATION_FAILED_COUNT" -gt 0 ]; then
    return 1
  fi

  NPM_ENV_INSPECTED=0
  NPM_PACKAGE_COUNT="unknown"
  NVM_INACTIVE_PREFIX_COUNT=0
  : >"$NVM_MIGRATION_FILE"
  log_event "migration" "$MIGRATION_SOURCE" "run=$RUN_ID status=complete migrated=$MIGRATION_MIGRATED_COUNT target=$NPM_ACTIVE_PREFIX"
  return 0
}

run_nvm_migration() {
  inspect_npm_environment
  if [ "$NPM_ACTIVE_PREFIX" = "unknown" ]; then
    warn "unable to migrate without an active npm prefix"
    return 1
  fi
  nvm_root=${NVM_DIR:-$HOME/.nvm}
  case "$NPM_ACTIVE_PREFIX" in
    "$nvm_root"/versions/node/*) ;;
    *)
      warn "active npm prefix is not managed by NVM: $NPM_ACTIVE_PREFIX"
      return 1
      ;;
  esac

  if [ ! -s "$NVM_MIGRATION_FILE" ]; then
    printf 'No packages found to migrate from inactive NVM environments.\n'
    log_event "migration" "none" "run=$RUN_ID status=nothing-to-migrate target=$NPM_ACTIVE_PREFIX"
    return 0
  fi

  if select_migration_source; then
    selection_status=0
  else
    selection_status=$?
  fi
  case "$selection_status" in
    1) return 1 ;;
    2) return 2 ;;
    3) return 3 ;;
  esac

  print_migration_preview
  log_event "migration" "$MIGRATION_SOURCE" "run=$RUN_ID status=preview packages=$MIGRATION_PACKAGE_COUNT target=$NPM_ACTIVE_PREFIX"
  if [ "$CHECK_ONLY" -eq 1 ]; then
    return 2
  fi

  if [ "$ASSUME_YES" -ne 1 ]; then
    printf 'Migrate these %s packages? [y/N] ' "$MIGRATION_PACKAGE_COUNT"
    read -r migration_answer || migration_answer=""
    case "$migration_answer" in
      y|Y|yes|YES) ;;
      *) return 3 ;;
    esac
  fi

  perform_nvm_migration
}

uv_list_tools() {
  # shellcheck disable=SC2086
  set -- $UV_CMD
  "$@" tool list
}

uv_tool_dir() {
  # shellcheck disable=SC2086
  set -- $UV_CMD
  "$@" tool dir
}

uv_install_pkg() {
  package_name=$1
  # shellcheck disable=SC2086
  set -- $UV_CMD
  "$@" tool upgrade "$package_name"
}

append_update() {
  manager_name=$1
  package_name=$2
  current_version=$3
  latest_version=$4
  action=$5

  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$manager_name" "$package_name" "$current_version" "$latest_version" "$action" >>"$ALL_UPDATES_FILE"

  if [ "$action" = "update" ]; then
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$manager_name" "$package_name" "$current_version" "$latest_version" "$action" >>"$TO_INSTALL_FILE"
  fi
}

collect_pip_updates() {
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 is required to parse pip update output"
    return 1
  fi

  pip_json=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-pip.XXXXXX") || return 1
  pip_err=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-pip-err.XXXXXX") || {
    rm -f "$pip_json"
    return 1
  }
  pip_parsed=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-pip-parsed.XXXXXX") || {
    rm -f "$pip_json" "$pip_err"
    return 1
  }

  verbose "scanning pip: $PIP_CMD list --outdated --format=json"
  if ! pip_list_outdated >"$pip_json" 2>"$pip_err"; then
    warn "pip scan failed: $(tail -n 1 "$pip_err" 2>/dev/null)"
    verbose_file "$pip_err"
    rm -f "$pip_json" "$pip_err" "$pip_parsed"
    return 1
  fi

  if [ ! -s "$pip_json" ]; then
    verbose "pip scan complete: outdated=0"
    verbose_file "$pip_err"
    rm -f "$pip_json" "$pip_err" "$pip_parsed"
    return 0
  fi

  if ! python3 - "$pip_json" >"$pip_parsed" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, 'r', encoding='utf-8') as fh:
    raw = fh.read().strip()
if not raw:
    raise SystemExit(0)
items = json.loads(raw)
for item in items:
    name = item.get('name', '')
    current = item.get('version', '')
    latest = item.get('latest_version', '')
    if name:
        print(f"{name}\t{current}\t{latest}")
PY
  then
    warn "failed to parse pip update output"
    verbose_file "$pip_err"
    rm -f "$pip_json" "$pip_err" "$pip_parsed"
    return 1
  fi

  PIP_OUTDATED_COUNT=$(wc -l <"$pip_parsed" | tr -d ' ')
  verbose "pip scan complete: outdated=$PIP_OUTDATED_COUNT"
  verbose_file "$pip_err"

  while IFS="$TAB" read -r package_name current_version latest_version; do
    [ -n "${package_name:-}" ] || continue

    action="update"
    if is_excluded "$PIP_EXCLUDE" "$package_name"; then
      action="held"
    fi

    append_update "pip" "$package_name" "${current_version:-unknown}" "${latest_version:-unknown}" "$action"
  done <"$pip_parsed"

  rm -f "$pip_json" "$pip_err" "$pip_parsed"
  return 0
}

collect_uv_updates() {
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 is required to parse uv update output"
    return 1
  fi

  uv_list_file=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-uv-list.XXXXXX") || return 1
  uv_err=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-uv-err.XXXXXX") || {
    rm -f "$uv_list_file"
    return 1
  }

  uv_scan_failed=0
  verbose "scanning uv tools: $UV_CMD tool list"
  if ! uv_list_tools >"$uv_list_file" 2>"$uv_err"; then
    warn "uv scan failed: $(tail -n 1 "$uv_err" 2>/dev/null)"
    verbose_file "$uv_err"
    rm -f "$uv_list_file" "$uv_err"
    return 1
  fi

  if grep -Fxq "No tools installed" "$uv_list_file"; then
    verbose "uv scan complete: tools=0 outdated=0"
    verbose_file "$uv_err"
    rm -f "$uv_list_file" "$uv_err"
    return 0
  fi

  if uv_root=$(uv_tool_dir 2>>"$uv_err"); then
    :
  else
    warn "uv scan failed: $(tail -n 1 "$uv_err" 2>/dev/null)"
    verbose_file "$uv_err"
    rm -f "$uv_list_file" "$uv_err"
    return 1
  fi

  while IFS= read -r line; do
    case "$line" in
      ""|"No tools installed"|"$TAB"*|" "*)
        continue
        ;;
    esac

    set -- $line
    tool_name=${1:-}
    tool_name=${tool_name%:}
    [ -n "$tool_name" ] || continue
    UV_TOOL_COUNT=$((UV_TOOL_COUNT + 1))

    tool_python="$uv_root/$tool_name/bin/python"
    if [ ! -x "$tool_python" ]; then
      warn "uv tool environment missing python: $tool_name"
      uv_scan_failed=1
      continue
    fi

    uv_tool_json=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-uv-tool.XXXXXX") || {
      warn "unable to create uv scan temp file for $tool_name"
      uv_scan_failed=1
      continue
    }
    uv_tool_err=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-uv-tool-err.XXXXXX") || {
      rm -f "$uv_tool_json"
      warn "unable to create uv error temp file for $tool_name"
      uv_scan_failed=1
      continue
    }
    uv_tool_parsed=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-uv-tool-parsed.XXXXXX") || {
      rm -f "$uv_tool_json" "$uv_tool_err"
      warn "unable to create uv parse temp file for $tool_name"
      uv_scan_failed=1
      continue
    }

    verbose "scanning uv tool: $tool_name"
    if ! "$tool_python" -m pip list --outdated --format=json >"$uv_tool_json" 2>"$uv_tool_err"; then
      warn "uv tool scan failed for $tool_name: $(tail -n 1 "$uv_tool_err" 2>/dev/null)"
      verbose_file "$uv_tool_err"
      rm -f "$uv_tool_json" "$uv_tool_err" "$uv_tool_parsed"
      uv_scan_failed=1
      continue
    fi

    if ! python3 - "$uv_tool_json" "$tool_name" >"$uv_tool_parsed" <<'PY'
import json
import sys

path = sys.argv[1]
tool_name = sys.argv[2]

def normalize(name: str) -> str:
    return name.lower().replace("_", "-")

with open(path, 'r', encoding='utf-8') as fh:
    raw = fh.read().strip()
if not raw:
    raise SystemExit(0)
items = json.loads(raw)
tool_name_norm = normalize(tool_name)
for item in items:
    name = item.get('name', '')
    if normalize(name) != tool_name_norm:
        continue
    current = item.get('version', '')
    latest = item.get('latest_version', '')
    print(f"{name}\t{current}\t{latest}")
    break
PY
    then
      warn "failed to parse uv tool output for $tool_name"
      verbose_file "$uv_tool_err"
      rm -f "$uv_tool_json" "$uv_tool_err" "$uv_tool_parsed"
      uv_scan_failed=1
      continue
    fi

    if [ -s "$uv_tool_parsed" ]; then
      uv_tool_outdated_count=$(wc -l <"$uv_tool_parsed" | tr -d ' ')
      UV_OUTDATED_COUNT=$((UV_OUTDATED_COUNT + uv_tool_outdated_count))
      while IFS="$TAB" read -r package_name current_version latest_version; do
        [ -n "${package_name:-}" ] || continue

        action="update"
        if is_excluded "$UV_EXCLUDE" "$package_name" || is_excluded "$UV_EXCLUDE" "$tool_name"; then
          action="held"
        fi

        append_update "uv" "$package_name" "${current_version:-unknown}" "${latest_version:-unknown}" "$action"
      done <"$uv_tool_parsed"
    fi

    verbose_file "$uv_tool_err"

    rm -f "$uv_tool_json" "$uv_tool_err" "$uv_tool_parsed"
  done <"$uv_list_file"

  verbose "uv scan complete: tools=$UV_TOOL_COUNT outdated=$UV_OUTDATED_COUNT"
  verbose_file "$uv_err"
  rm -f "$uv_list_file" "$uv_err"
  if [ "$uv_scan_failed" -eq 1 ]; then
    return 1
  fi
  return 0
}

collect_npm_updates() {
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 is required to parse npm update output"
    return 1
  fi

  inspect_npm_environment

  npm_json=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-npm.XXXXXX") || return 1
  npm_err=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-npm-err.XXXXXX") || {
    rm -f "$npm_json"
    return 1
  }
  npm_parsed=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-npm-parsed.XXXXXX") || {
    rm -f "$npm_json" "$npm_err"
    return 1
  }

  verbose "scanning npm: $NPM_CMD outdated -g --json"
  if npm_list_outdated >"$npm_json" 2>"$npm_err"; then
    npm_status=0
  else
    npm_status=$?
  fi

  if [ "$npm_status" -gt 1 ]; then
    warn "npm scan failed: $(tail -n 1 "$npm_err" 2>/dev/null)"
    verbose_file "$npm_err"
    rm -f "$npm_json" "$npm_err" "$npm_parsed"
    return 1
  fi

  if [ ! -s "$npm_json" ]; then
    verbose "npm scan complete: packages=$NPM_PACKAGE_COUNT outdated=0"
    verbose_file "$npm_err"
    rm -f "$npm_json" "$npm_err" "$npm_parsed"
    return 0
  fi

  if ! python3 - "$npm_json" >"$npm_parsed" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, 'r', encoding='utf-8') as fh:
    raw = fh.read().strip()
if not raw:
    raise SystemExit(0)
obj = json.loads(raw)
if not isinstance(obj, dict):
    raise SystemExit(0)
for name, meta in obj.items():
    if not isinstance(meta, dict):
        continue
    current = str(meta.get('current', ''))
    latest = str(meta.get('latest', ''))
    print(f"{name}\t{current}\t{latest}")
PY
  then
    warn "failed to parse npm update output"
    verbose_file "$npm_err"
    rm -f "$npm_json" "$npm_err" "$npm_parsed"
    return 1
  fi

  NPM_OUTDATED_COUNT=$(wc -l <"$npm_parsed" | tr -d ' ')
  verbose "npm scan complete: packages=$NPM_PACKAGE_COUNT outdated=$NPM_OUTDATED_COUNT"
  verbose_file "$npm_err"

  while IFS="$TAB" read -r package_name current_version latest_version; do
    [ -n "${package_name:-}" ] || continue

    action="update"
    if is_excluded "$NPM_EXCLUDE" "$package_name"; then
      action="held"
    fi

    append_update "npm" "$package_name" "${current_version:-unknown}" "${latest_version:-unknown}" "$action"
  done <"$npm_parsed"

  rm -f "$npm_json" "$npm_err" "$npm_parsed"
  return 0
}

print_table() {
  printf '%-8s %-30s %-16s %-16s %-8s\n' "manager" "package" "current" "latest" "action"
  printf '%-8s %-30s %-16s %-16s %-8s\n' "-------" "------------------------------" "----------------" "----------------" "------"

  while IFS="$TAB" read -r manager_name package_name current_version latest_version action; do
    printf '%-8s %-30s %-16s %-16s %-8s\n' \
      "$manager_name" "$package_name" "$current_version" "$latest_version" "$action"
  done <"$ALL_UPDATES_FILE"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)
      CHECK_ONLY=1
      ;;
    --yes)
      ASSUME_YES=1
      ;;
    --manager)
      [ "$#" -ge 2 ] || die "--manager requires a value"
      case "$2" in
        pip|uv|npm|all)
          MANAGER="$2"
          ;;
        *)
          die "invalid --manager value: $2"
          ;;
      esac
      shift
      ;;
    --migrate-nvm)
      MIGRATE_NVM=1
      ;;
    --migrate-nvm-from)
      [ "$#" -ge 2 ] || die "--migrate-nvm-from requires a version"
      MIGRATE_NVM=1
      MIGRATE_NVM_FROM="$2"
      shift
      ;;
    --config)
      [ "$#" -ge 2 ] || die "--config requires a path"
      CONFIG_FILE="$2"
      shift
      ;;
    --verbose)
      VERBOSE=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
  shift
done

if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

if [ "$MIGRATE_NVM" -eq 1 ]; then
  case "$MANAGER" in
    all|npm) ;;
    *) die "NVM migration requires --manager npm or --manager all" ;;
  esac
fi

ALL_UPDATES_FILE=""
TO_INSTALL_FILE=""
FAILURES_FILE=""
NVM_MIGRATION_FILE=""
NVM_SOURCES_FILE=""

cleanup() {
  [ -n "$ALL_UPDATES_FILE" ] && rm -f "$ALL_UPDATES_FILE"
  [ -n "$TO_INSTALL_FILE" ] && rm -f "$TO_INSTALL_FILE"
  [ -n "$FAILURES_FILE" ] && rm -f "$FAILURES_FILE"
  [ -n "$NVM_MIGRATION_FILE" ] && rm -f "$NVM_MIGRATION_FILE"
  [ -n "$NVM_SOURCES_FILE" ] && rm -f "$NVM_SOURCES_FILE"
}

finalize_run() {
  final_rc=$?
  trap - EXIT
  if [ "$RUN_STARTED" -eq 1 ]; then
    log_event "run" "$RUN_ID" "finish outcome=$RUN_OUTCOME rc=$final_rc manager=$MANAGER found=$total_count updatable=$install_count held=$hold_count updated=$updated_count failed=$failed_count scan_errors=$runtime_error migration_requested=$MIGRATION_PACKAGE_COUNT migrated=$MIGRATION_MIGRATED_COUNT migration_failed=$MIGRATION_FAILED_COUNT"
  fi
  cleanup
  exit "$final_rc"
}

trap finalize_run EXIT
trap 'RUN_OUTCOME="interrupted"; exit 130' INT TERM

run_mode="install"
if [ "$CHECK_ONLY" -eq 1 ]; then
  run_mode="check"
fi
if [ "$MIGRATE_NVM" -eq 1 ]; then
  run_mode="migrate"
  if [ "$CHECK_ONLY" -eq 1 ]; then
    run_mode="migrate-check"
  fi
fi
RUN_STARTED=1
log_event "run" "$RUN_ID" "start mode=$run_mode manager=$MANAGER"

ALL_UPDATES_FILE=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-all.XXXXXX") || die "unable to create temp file"
TO_INSTALL_FILE=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-install.XXXXXX") || die "unable to create temp file"
FAILURES_FILE=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-failures.XXXXXX") || die "unable to create temp file"
NVM_MIGRATION_FILE=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-nvm-migration.XXXXXX") || die "unable to create temp file"
NVM_SOURCES_FILE=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-nvm-sources.XXXXXX") || die "unable to create temp file"

if [ "$MIGRATE_NVM" -eq 1 ]; then
  npm_bin=$(first_word "$NPM_CMD" || true)
  if [ -z "$npm_bin" ] || ! command -v "$npm_bin" >/dev/null 2>&1; then
    RUN_OUTCOME="migration-failed"
    die "npm manager unavailable for NVM migration (missing command: $npm_bin)"
  fi
  if run_nvm_migration; then
    migration_status=0
  else
    migration_status=$?
  fi
  case "$migration_status" in
    0) ;;
    2)
      RUN_OUTCOME="migration-available"
      exit 2
      ;;
    3)
      printf 'Migration aborted.\n'
      RUN_OUTCOME="aborted"
      exit 0
      ;;
    *)
      RUN_OUTCOME="migration-failed"
      exit 1
      ;;
  esac
fi

want_pip=0
want_uv=0
want_npm=0
case "$MANAGER" in
  all)
    want_pip=1
    want_uv=1
    want_npm=1
    ;;
  pip)
    want_pip=1
    ;;
  uv)
    want_uv=1
    ;;
  npm)
    want_npm=1
    ;;
esac

available_managers=0
runtime_error=0

if [ "$want_pip" -eq 1 ]; then
  pip_bin=$(first_word "$PIP_CMD" || true)
  if [ -n "$pip_bin" ] && command -v "$pip_bin" >/dev/null 2>&1; then
    available_managers=$((available_managers + 1))
    if collect_pip_updates; then
      log_event "scan" "pip" "run=$RUN_ID status=ok outdated=$PIP_OUTDATED_COUNT"
    else
      runtime_error=1
      log_event "scan" "pip" "run=$RUN_ID status=failed outdated=$PIP_OUTDATED_COUNT"
    fi
  else
    warn "pip manager unavailable (missing command: $pip_bin)"
    runtime_error=1
    log_event "scan" "pip" "run=$RUN_ID status=unavailable command=$pip_bin"
  fi
fi

if [ "$want_uv" -eq 1 ]; then
  uv_bin=$(first_word "$UV_CMD" || true)
  if [ -n "$uv_bin" ] && command -v "$uv_bin" >/dev/null 2>&1; then
    available_managers=$((available_managers + 1))
    if collect_uv_updates; then
      log_event "scan" "uv" "run=$RUN_ID status=ok tools=$UV_TOOL_COUNT outdated=$UV_OUTDATED_COUNT"
    else
      runtime_error=1
      log_event "scan" "uv" "run=$RUN_ID status=failed tools=$UV_TOOL_COUNT outdated=$UV_OUTDATED_COUNT"
    fi
  else
    warn "uv manager unavailable (missing command: $uv_bin)"
    runtime_error=1
    log_event "scan" "uv" "run=$RUN_ID status=unavailable command=$uv_bin"
  fi
fi

if [ "$want_npm" -eq 1 ]; then
  npm_bin=$(first_word "$NPM_CMD" || true)
  if [ -n "$npm_bin" ] && command -v "$npm_bin" >/dev/null 2>&1; then
    available_managers=$((available_managers + 1))
    if collect_npm_updates; then
      log_event "scan" "npm" "run=$RUN_ID status=ok prefix=$NPM_ACTIVE_PREFIX packages=$NPM_PACKAGE_COUNT outdated=$NPM_OUTDATED_COUNT inactive_nvm_prefixes=$NVM_INACTIVE_PREFIX_COUNT"
    else
      runtime_error=1
      log_event "scan" "npm" "run=$RUN_ID status=failed prefix=$NPM_ACTIVE_PREFIX packages=$NPM_PACKAGE_COUNT outdated=$NPM_OUTDATED_COUNT"
    fi
  else
    warn "npm manager unavailable (missing command: $npm_bin)"
    runtime_error=1
    log_event "scan" "npm" "run=$RUN_ID status=unavailable command=$npm_bin"
  fi
fi

if [ "$available_managers" -eq 0 ]; then
  RUN_OUTCOME="scan-failed"
  die "no selected package managers are available"
fi

total_count=$(wc -l <"$ALL_UPDATES_FILE" | tr -d ' ')
hold_count=$(awk -F '\t' '$5 == "held" { c += 1 } END { print c + 0 }' "$ALL_UPDATES_FILE")
install_count=$(wc -l <"$TO_INSTALL_FILE" | tr -d ' ')

if [ "$total_count" -eq 0 ]; then
  if [ "$runtime_error" -eq 1 ]; then
    RUN_OUTCOME="scan-failed"
    printf 'No updates confirmed because one or more selected scans failed.\n'
    exit 1
  fi
  RUN_OUTCOME="no-updates"
  printf 'No updates found for selected non-APT manager(s): %s.\n' "$MANAGER"
  exit 0
fi

print_table

if [ "$CHECK_ONLY" -eq 1 ]; then
  printf '\nSummary: found=%s updatable=%s held=%s scan_errors=%s\n' "$total_count" "$install_count" "$hold_count" "$runtime_error"

  if [ "$runtime_error" -eq 1 ]; then
    RUN_OUTCOME="partial-scan"
    exit 1
  fi
  if [ "$install_count" -gt 0 ]; then
    RUN_OUTCOME="updates-available"
    exit 2
  fi
  RUN_OUTCOME="all-held"
  exit 0
fi

if [ "$install_count" -eq 0 ]; then
  printf '\nNo installable updates (all updates are held).\n'
  if [ "$runtime_error" -eq 1 ]; then
    RUN_OUTCOME="partial-scan"
    exit 1
  fi
  RUN_OUTCOME="all-held"
  exit 0
fi

if [ "$ASSUME_YES" -ne 1 ]; then
  printf '\nProceed with install? [y/N] '
  read -r answer || answer=""
  case "$answer" in
    y|Y|yes|YES)
      ;;
    *)
      printf 'Aborted.\n'
      RUN_OUTCOME="aborted"
      exit 0
      ;;
  esac
fi

while IFS="$TAB" read -r manager_name package_name current_version latest_version action; do
  [ "$action" = "update" ] || continue

  install_log=$(mktemp "${TMPDIR:-/tmp}/pkg-maint-install-log.XXXXXX") || {
    warn "unable to create install log temp file"
    failed_count=$((failed_count + 1))
    continue
  }

  printf 'Installing %s (%s -> %s) via %s...\n' "$package_name" "$current_version" "$latest_version" "$manager_name"

  if [ "$manager_name" = "pip" ]; then
    if pip_install_pkg "$package_name" >"$install_log" 2>&1; then
      rc=0
    else
      rc=$?
    fi
  elif [ "$manager_name" = "uv" ]; then
    if uv_install_pkg "$package_name" >"$install_log" 2>&1; then
      rc=0
    else
      rc=$?
    fi
  else
    if npm_install_pkg "$package_name" >"$install_log" 2>&1; then
      rc=0
    else
      rc=$?
    fi
  fi

  if [ "$rc" -eq 0 ]; then
    updated_count=$((updated_count + 1))
    log_result "$manager_name" "$package_name" "$current_version" "$latest_version" "ok run=$RUN_ID"
    if [ "$VERBOSE" -eq 1 ]; then
      sed 's/^/  /' "$install_log"
    fi
  else
    failed_count=$((failed_count + 1))
    failure_reason="install failed"
    if grep -Eiq 'permission denied|EACCES|operation not permitted|not permitted' "$install_log"; then
      failure_reason="permission denied"
    fi

    warn "failed to install $manager_name/$package_name: $failure_reason"
    if [ "$VERBOSE" -eq 1 ]; then
      sed 's/^/  /' "$install_log" >&2
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$manager_name" "$package_name" "$current_version" "$latest_version" "$failure_reason" >>"$FAILURES_FILE"

    log_result "$manager_name" "$package_name" "$current_version" "$latest_version" "failed:$failure_reason run=$RUN_ID"
  fi

  rm -f "$install_log"
done <"$TO_INSTALL_FILE"

printf '\nSummary: found=%s updatable=%s held=%s updated=%s failed=%s scan_errors=%s\n' \
  "$total_count" "$install_count" "$hold_count" "$updated_count" "$failed_count" "$runtime_error"

if [ "$failed_count" -gt 0 ]; then
  printf 'Failures:\n'
  while IFS="$TAB" read -r manager_name package_name current_version latest_version failure_reason; do
    printf '  %s/%s (%s -> %s): %s\n' \
      "$manager_name" "$package_name" "$current_version" "$latest_version" "$failure_reason"
  done <"$FAILURES_FILE"
fi

if [ "$runtime_error" -eq 1 ] || [ "$failed_count" -gt 0 ]; then
  RUN_OUTCOME="failed"
  exit 1
fi

RUN_OUTCOME="completed"
exit 0
